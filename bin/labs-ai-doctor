#!/usr/bin/env bash
set -euo pipefail

echo "=========================================================="
echo "          LABS AI CONTEXT & HARNESS DOCTOR                "
echo "=========================================================="

ERRORS=0
WARNINGS=0

# 1. Checagem do RTK
if command -v rtk >/dev/null 2>&1; then
    RTK_VER=$(rtk --version 2>/dev/null || echo "ok")
    echo "  [OK] Binário RTK presente: $RTK_VER"
else
    echo "  [FAIL] Binário RTK não encontrado no PATH."
    ERRORS=$((ERRORS + 1))
fi

# 2. Checagem do Hook do Claude Code
CLAUDE_SETTINGS="$HOME/.claude/settings.json"
if [ -f "$CLAUDE_SETTINGS" ]; then
    if grep -q "rtk hook claude" "$CLAUDE_SETTINGS"; then
        echo "  [OK] Hook PreToolUse do Claude Code ativo (RTK)."
    else
        echo "  [WARN] Hook do RTK ausente em ~/.claude/settings.json."
        WARNINGS=$((WARNINGS + 1))
    fi

    # 3. Checagem da Persistência Forçada
    if grep -q '"CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1"' "$CLAUDE_SETTINGS"; then
        echo "  [ALERT] Persistência forçada de sessão ATIVA no Claude! Risco de estourar quota."
        ERRORS=$((ERRORS + 1))
    else
        echo "  [OK] Persistência forçada de sessão desativada no Claude (efêmero por padrão)."
    fi

    # Trava de modelo dos subagentes e plugins obrigatórios
    if grep -q '"CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"' "$CLAUDE_SETTINGS"; then
        echo "  [OK] Subagentes travados no Sonnet."
    else
        echo "  [WARN] CLAUDE_CODE_SUBAGENT_MODEL=sonnet ausente em ~/.claude/settings.json."
        WARNINGS=$((WARNINGS + 1))
    fi
    if grep -q '"CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"' "$CLAUDE_SETTINGS"; then
        echo "  [OK] Trava do Sonnet forçada (CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1)."
    else
        echo "  [WARN] CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1 ausente: o model da invocação passa por cima do Sonnet."
        WARNINGS=$((WARNINGS + 1))
    fi
    for PLUGIN in superpowers ponytail gopls-lsp; do
        if grep -q "\"$PLUGIN@[^\"]*\": true" "$CLAUDE_SETTINGS"; then
            echo "  [OK] Plugin $PLUGIN habilitado."
        else
            echo "  [WARN] Plugin $PLUGIN não habilitado no Claude Code."
            WARNINGS=$((WARNINGS + 1))
        fi
    done
else
    echo "  [WARN] Configuração ~/.claude/settings.json não encontrada."
    WARNINGS=$((WARNINGS + 1))
fi

# 4. Checagem do Plugin Nativo do RTK no Antigravity / Gemini
GEMINI_PLUGIN="$HOME/.gemini/config/plugins/rtk/plugin.json"
GEMINI_HOOK="$HOME/.gemini/config/plugins/rtk/hooks.json"
if [ -f "$GEMINI_PLUGIN" ] && [ -f "$GEMINI_HOOK" ]; then
    echo "  [OK] Plugin nativo RTK ativo no Antigravity/Gemini."
else
    echo "  [WARN] Plugin RTK ausente em ~/.gemini/config/plugins/rtk/."
    WARNINGS=$((WARNINGS + 1))
fi

# 5. Checagem da Doutrina Ponytail no Gemini
GEMINI_MD="$HOME/.gemini/config/GEMINI.md"
GEMINI_PONYTAIL="$HOME/.gemini/config/plugins/ponytail/rules/AGENTS.md"
if grep -qs "Doutrina Ponytail" "$GEMINI_MD" "$GEMINI_PONYTAIL"; then
    echo "  [OK] Doutrina Ponytail ativa nas regras do Gemini."
else
    echo "  [WARN] Doutrina Ponytail não detectada (GEMINI.md nem plugin ponytail)."
    WARNINGS=$((WARNINGS + 1))
fi

echo "=========================================================="
if [ "$ERRORS" -eq 0 ] && [ "$WARNINGS" -eq 0 ]; then
    echo " STATUS: 100% VERDE - O ambiente segue a Norma Canônica Labs."
elif [ "$ERRORS" -eq 0 ]; then
    echo " STATUS: OPERACIONAL COM AVISOS ($WARNINGS avisos)."
else
    echo " STATUS: FALHA CRÍTICA ($ERRORS erros, $WARNINGS avisos)."
    exit 1
fi
echo "=========================================================="
